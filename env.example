# Microsoft Foundry project endpoint
# Format:
# https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Chat model deployment created inside the Foundry project
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1

# Embedding model deployment created inside the Foundry project
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>

# Application metadata
APP_NAME=azure-ai-foundry-langgraph-agents
APP_ENVIRONMENT=local
APP_VERSION=0.1.0

# Generation defaults
MODEL_MAX_OUTPUT_TOKENS=800
# SYSTEM_PROMPT=<optional override; omit to use the application default>

# Router configuration
ROUTER_MAX_OUTPUT_TOKENS=16
# ROUTER_PROMPT=<optional override; omit to use the Sprint 3 router default>

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=supply-chain-docs
AZURE_SEARCH_ADMIN_KEY=<your-search-admin-key>
AZURE_SEARCH_TOP_K=3
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Telemetry
TELEMETRY_CONSOLE_ENABLED=true
AZURE_MONITOR_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
AZURE_MONITOR_LOGGER_NAME=agent.telemetry
AZURE_MONITOR_FORCE_FLUSH=false
AZURE_MONITOR_FLUSH_TIMEOUT_MS=10000
# Sprint 3 specialist prompts (optional overrides)
# ROUTER_PROMPT=Classify into the supported single-domain or combined routes.
# INVENTORY_PROMPT=You are the Inventory Agent...
# SUPPLIER_PROMPT=You are the Supplier Agent...
# TIME_PROMPT=You are the Time Agent...
# Sprint 3B multi-agent synthesis prompt (optional override)
# MULTI_AGENT_PROMPT=You are the Supply Chain Supervisor...

# Sprint 3C uses deterministic entity extraction and focused specialist queries.
# No additional environment variable is required.

# Optional specialist prompt override
# LOGISTICS_PROMPT=
