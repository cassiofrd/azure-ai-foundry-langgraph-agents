# Azure AI Foundry project
# https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure OpenAI endpoint used by the embedding client
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>

# Application metadata
APP_NAME=azure-ai-foundry-langgraph-agents
APP_ENVIRONMENT=local
APP_VERSION=1.0.0

# Generation and routing
MODEL_MAX_OUTPUT_TOKENS=800
ROUTER_MAX_OUTPUT_TOKENS=16
# SYSTEM_PROMPT=<optional override>
# ROUTER_PROMPT=<optional override>
# INVENTORY_PROMPT=<optional override>
# SUPPLIER_PROMPT=<optional override>
# LOGISTICS_PROMPT=<optional override>
# TIME_PROMPT=<optional override>
# MULTI_AGENT_PROMPT=<optional override>

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=supply-chain-docs
AZURE_SEARCH_ADMIN_KEY=<your-search-admin-key>
AZURE_SEARCH_TOP_K=3
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_VECTOR_DIMENSIONS=1536

# Telemetry
TELEMETRY_CONSOLE_ENABLED=true
AZURE_MONITOR_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
AZURE_MONITOR_LOGGER_NAME=agent.telemetry
AZURE_MONITOR_FORCE_FLUSH=false
AZURE_MONITOR_FLUSH_TIMEOUT_MS=10000

# Conversation memory
# Use memory for local development. Use redis for persistent sessions.
CONVERSATION_STORE_BACKEND=memory
CONVERSATION_STORE_FALLBACK_TO_MEMORY=false
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_HISTORY_LIMIT=12
CONVERSATION_KEY_PREFIX=agent:conversation
DEFAULT_SESSION_ID=local-demo

# REST API
API_HOST=127.0.0.1
API_PORT=8000
